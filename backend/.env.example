# ─────────────────────────────────────────────────────────────────────
# .env.example — Sao chép thành .env rồi điền giá trị thực
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────
APP_NAME="RAG Document QA"
APP_VERSION="0.1.0"
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── MinIO ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ORIGINAL=documents-original
MINIO_BUCKET_PROCESSED=documents-processed
MINIO_BUCKET_OCR=documents-ocr

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── Embedding (BGE-M3) ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
VECTOR_SIZE=1024

# ── Reranker ──────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5

# ── Ollama / LLM ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ── Chunking ─────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20

# ── Auth / JWT ────────────────────────────────────────────────────────
# ⚠️  Thay bằng chuỗi ngẫu nhiên dài ≥ 32 ký tự khi production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Upload ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
