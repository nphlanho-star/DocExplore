# ─────────────────────────────────────────────────────────────────────
# .env.example — Sao chép thành .env rồi điền giá trị thực
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────
APP_NAME="RAG Document QA"
APP_VERSION="0.1.0"
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Storage ───────────────────────────────────────────────────────────
# Hiện lưu file bằng hệ thống file cục bộ (backend/storage/); các biến MINIO_* giữ lại cho tương thích
MINIO_ENDPOINT=localhost:4566
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test
MINIO_SECURE=false
MINIO_BUCKET_ORIGINAL=documents-original
MINIO_BUCKET_PROCESSED=documents-processed
MINIO_BUCKET_OCR=documents-ocr

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── Embedding (BGE-M3) ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
VECTOR_SIZE=1024

# ── Reranker ──────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5
# "cuda" nếu muốn reranker cũng dùng GPU. Để "cpu" nếu muốn tách riêng khỏi
# EMBEDDING_DEVICE (vd: embedding GPU + reranker CPU) — dùng chung GPU nhỏ
# với Ollama sẽ đỡ tốn VRAM hơn.
RERANKER_DEVICE=cpu

# ── Ollama / LLM ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Chunking ─────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20

# Hybrid Search (dense + sparse/BM25-style bằng BGE-M3, gộp RRF)
# ⚠️ Bật LẦN ĐẦU sẽ xoá & tạo lại collection Qdrant → phải upload lại tài liệu
HYBRID_SEARCH_ENABLED=false

# ── Auth / JWT ────────────────────────────────────────────────────────
# ⚠️  Thay bằng chuỗi ngẫu nhiên dài ≥ 32 ký tự khi production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Upload ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# --- Web search bổ sung (Tavily) — chỉ cho câu hỏi pháp luật ngoài tài liệu ---
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=false
WEB_SEARCH_DOMAINS=thuvienphapluat.vn,vbpl.vn,chinhphu.vn,moj.gov.vn,luatvietnam.vn

# ── Tốc độ / chất lượng truy xuất ─────────────────────────────────────
RERANK_MIN_SCORE=0.15
RERANK_MAX_LENGTH=384
HYDE_MIN_TOP_SCORE=0.03

# ── Nén context & bộ nhớ hội thoại ────────────────────────────────────
CONTEXT_COMPRESS_ENABLED=true
MEMORY_BUDGET_CHARS=8000
MEMORY_COMPACT_MIN=0.60
MEMORY_COMPACT_MAX=0.85
MEMORY_KEEP_TURNS=2
MEMORY_SUMMARY_CHARS=1800
